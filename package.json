{
  "name": "portcullis-server",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "start": "node dist/server/index.js",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:integration": "PORTCULLIS_TESTNET=1 vitest run test/integration",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit"
  },

  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@stellar/stellar-sdk": "17.2.1",
    "hono": "4.13.12",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.0",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
